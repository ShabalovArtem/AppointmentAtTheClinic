# Copy as .env (cp .env.example .env); docker compose reads it. Every value has the same default
# in compose.yaml, so a missing .env changes nothing.

# Published ports (README.md); change if a port is busy and update checks.yaml.
NGINX_PORT=8080
APP_A_PORT=8001
APP_B_PORT=8002
GATEWAY_A_PORT=8091
GATEWAY_B_PORT=8092
SIM_PORT=8090
FLAGS_PORT=8099
POSTGRES_PORT=5432
KAFKA_HOST_PORT=9094
KAFKA_UI_PORT=8085
REDIS_PORT=6379
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# The web client runs outside Compose on this origin (CORS, Origin of WebSocket).
CLIENT_ORIGIN=http://localhost:8081

# Database limits (D2.6): instances x POOL_SIZE + other processes < PG_MAX_CONNECTIONS.
PG_MAX_CONNECTIONS=100
POOL_SIZE=10

# Experiment modes; the skeleton reads them in server/app/config.py.
# C02: how long a web booking stays held before it must be confirmed (minutes).
HOLD_MINUTES=15
INVARIANT_MODE=protected
RATE_LIMIT_PER_MIN=120
JWT_REVOCATION=on
OTEL_ENABLED=off

# The simulator of your card (tools/external-sim/README.md).
SIM_NAME=insurance
SIM_ROUTE=/coverage
SIM_DELAY_MS=1000-6000
SIM_REJECT_SHARE=0.15
SIM_ERROR_SHARE=0.05
SIM_REJECT_REASONS="поліс не покриває цей вид прийому|строк дії поліса сплив"
SIM_SEED=

# Lab 6: stop migrations after this version (empty - all); image tags of the versions.
MIGRATE_TO=
APP_TAG=dev
CANARY_TAG=dev
CANARY_WEIGHT=0

# C02: login token lifetime (hours); accept X-User-Id without a token (labs 1-2, off from lab 3).
SESSION_HOURS=12
USER_HEADER=on

# Lab 2: idempotency keys lifetime and how long a duplicate waits (then 409); pause of INVARIANT_MODE=unprotected.
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_WAIT_MS=200
INVARIANT_GAP_MS=0
